APP_ENV=development
LOG_LEVEL=INFO

# Caminhos padronizados pelo instalador unificado.
AGENT_INSTALL_ROOT=/opt/agent-ia
AGENT_VENV_DIR=/opt/agent-ia/venv

# Backend de segredos: env ou vault.
SECRET_BACKEND=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=agent-ia
VAULT_VERIFY_TLS=true
VAULT_CACHE_SECONDS=60

SSH_DEFAULT_USER=2com
SSH_DEFAULT_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY_PASSPHRASE=
SSH_ALLOW_AGENT=true
SSH_LOOK_FOR_KEYS=true
SSH_DEFAULT_PORT=22
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=60
SSH_STRICT_HOST_KEY_CHECKING=true
SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts

# Servidor que controla as VPNs. Quando preenchido, o Agent entra primeiro
# neste SSH e abre, a partir dele, o canal para o IP VPN do servidor cliente.
SSH_SRV_VPN_IP=
SSH_SRV_VPN_PORT=22
SSH_SRV_VPN_USER=
SSH_SRV_VPN_SENHA=
SSH_BASTION_PRIVATE_KEY_PATH=
SSH_BASTION_PRIVATE_KEY_PASSPHRASE=

# O instalador gera senhas aleatórias e mantém estes serviços em loopback.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
POSTGRES_DSN=postgresql+psycopg://agent_ia:CHANGE_ME@127.0.0.1:5432/agent_ia
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/1

AGENT_EXECUTION_MODE=inline
AGENT_QUEUE_NAME=agent-ia:jobs
AGENT_RESULT_PREFIX=agent-ia:result:
AGENT_WORKER_NAME=vpn-principal
AGENT_JOB_TTL_SECONDS=86400
AGENT_QUEUE_BLOCK_SECONDS=5

AGENT_BATCH_ENABLED=true
AGENT_BATCH_MAX_TARGETS=50
AGENT_BATCH_CONCURRENCY=2
AGENT_BATCH_MAX_FILE_BYTES=1000000

AGENT_DEFAULT_MODE=propose
AGENT_AUTOPILOT_ENABLED=true
AGENT_AUTOPILOT_DEFAULT=true
AGENT_RUNTIME_DISCOVERY_ENABLED=true
AGENT_ADAPTIVE_TOOLS_ENABLED=true
AGENT_TOOL_RECOMMENDATION_LIMIT=10
AGENT_INTELLIGENT_REASONING_ENABLED=true
AGENT_REASONING_PROVIDER_FALLBACK=true
AGENT_REASONING_MAX_PROVIDER_ATTEMPTS=3
AGENT_CRITIC_ENABLED=true
AGENT_CRITIC_MIN_COVERAGE=70
AGENT_PLAYBOOK_ADVISORY_ONLY=true
AGENT_API_TOKEN=
AGENT_MAX_ROUNDS=5
AGENT_MAX_COMMANDS=20
AGENT_MIN_CONFIDENCE=70
AGENT_PLAYBOOK_DIR=/opt/agent-ia/app/config/playbooks
AGENT_ALLOW_LEGACY_READ_COMMANDS=true

AGENT_UI_OPERATOR_NAME=operador
AGENT_UI_HOST=0.0.0.0
AGENT_UI_PORT=8080
AGENT_UI_ENABLED=true
AGENT_UI_ALLOWED_NETWORKS=127.0.0.1/32,::1/128

CHECKMK_API_USER=
CHECKMK_API_SECRET=
CHECKMK_WEBHOOK_TOKEN=
CHECKMK_WEBHOOK_AUTO_CORRECT=false

# Catálogo e configuração dinâmica de IA.
AI_PROVIDER=gemini
AI_AUTO_PROVIDER_ORDER=groq,omniroute,deepseek,gemini,ollama,openrouter
AI_PREFLIGHT_TIMEOUT_SECONDS=8
AI_PROVIDER_REGISTRY_PATH=/opt/agent-ia/data/providers.json
AI_SETTINGS_ENV_PATH=/opt/agent-ia/app/.env
AI_SETTINGS_UI_ENABLED=true
AI_SETTINGS_ALLOW_SECRET_WRITE=true

GEMINI_API_KEY=
GEMINI_AUTO_FREE=true
GEMINI_TRANSIENT_FALLBACK=true
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FREE_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# DeepSeek oficial OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Agent IA Infra
OPENROUTER_SITE_URL=

# O instalador seleciona 1B em máquinas menores e 3B quando há mais memória.
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_AUTO_FALLBACK=true
OLLAMA_PREFERRED_MODELS=llama3.2:1b,llama3.2:3b
OLLAMA_PREFLIGHT_TIMEOUT_SECONDS=60

# Serviço local do OmniRoute gerenciado pelo Docker Compose.
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest
OMNIROUTE_BIND_ADDRESS=127.0.0.1
OMNIROUTE_PORT=20128
OMNIROUTE_ENV_FILE=/opt/agent-ia/config/omniroute.env
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_DEFAULT_ROUTE=auto/coding
OMNIROUTE_ROUTES=Código=auto/coding,Rápido=auto/fast,Econômico=auto/cheap,Inteligente=auto/smart
OMNIROUTE_MODEL=

AI_REVIEWER_PROVIDER=groq
AI_REVIEWER_MODEL=
AI_REVIEWER_REQUIRED_FOR_CORRECTIONS=true
AI_REVIEWER_MIN_CONFIDENCE=80

APPROVAL_SECRET=
APPROVAL_TTL_MINUTES=30

HELPDESK_WEBHOOK_URL=
HELPDESK_WEBHOOK_TOKEN=
HELPDESK_PUBLISH_AUTOMATICALLY=false

CODEX_CLI_PATH=
CODEX_WORKDIR=/opt/agent-ia/app
CODEX_HOME=~/.codex

OPENCODE_ENABLED=false
OPENCODE_CLI_PATH=
OPENCODE_WORKDIR=/opt/agent-ia/app
OPENCODE_CONFIG_PATH=~/.config/opencode/opencode.json
OPENCODE_MODEL=auto/coding
OPENCODE_SMALL_MODEL=auto/fast
OPENCODE_DEFAULT_AGENT=plan
OPENCODE_WEB_HOST=127.0.0.1
OPENCODE_WEB_PORT=4096
OPENCODE_WEB_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_TUNNEL_HOST=
OPENCODE_TUNNEL_SSH_PORT=22
OPENCODE_TUNNEL_USER=
OPENCODE_INTERFACE_ENABLED=true
OPENCODE_INTERFACE_ALLOW_BUILD=true
OPENCODE_RUN_TIMEOUT_SECONDS=900
OPENCODE_RUN_MAX_PROMPT_CHARS=12000
OPENCODE_RUN_MAX_OUTPUT_CHARS=250000
OPENCODE_RUN_CONCURRENCY=1

RECURRENCE_WARNING_COUNT=2
RECURRENCE_WARNING_DAYS=7
RECURRENCE_CRITICAL_COUNT=4
RECURRENCE_CRITICAL_DAYS=30
FILESYSTEM_WARNING_PERCENT=80
FILESYSTEM_CRITICAL_PERCENT=90
INODE_WARNING_PERCENT=80
INODE_CRITICAL_PERCENT=90
LOAD_WARNING_RATIO=1
LOAD_CRITICAL_RATIO=2
